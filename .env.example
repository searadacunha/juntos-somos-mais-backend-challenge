# Every variable is optional. The values below are the defaults.
# docker compose reads a file named .env placed next to docker-compose.yml.

# Where the two partner files are downloaded from at startup (http or https).
CSV_URL=https://storage.googleapis.com/juntossomosmais-code-challenge/input-backend.csv
JSON_URL=https://storage.googleapis.com/juntossomosmais-code-challenge/input-backend.json

# Seconds allowed for each phase of a download (connect, read, write).
HTTP_TIMEOUT_SECONDS=10

# Largest pageSize a client may ask for.
MAX_PAGE_SIZE=100

# DEBUG, INFO, WARNING, ERROR or CRITICAL.
LOG_LEVEL=INFO
